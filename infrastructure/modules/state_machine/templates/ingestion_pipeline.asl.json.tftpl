{
  "Comment": "Ingestion pipeline (T-02): InitializeJob -> mark_extracting -> Extract -> mark_indexing -> per-photo IndexFaces fan-out -> Finalize -> CheckIndexingOutcome. If zero photos succeeded, routes straight to JobFailed (mark_failed) - skipped ListAttendees/MatchAttendees entirely, since there are no new photos for them to match against. Otherwise: mark_matching -> ListAttendees -> per-attendee SearchFaces fan-out (MatchAttendees) -> UpdateJobStatus (mark_success, unconditional) -> IngestionSucceeded. db_api is called via named actions only (mark_extracting/mark_indexing/mark_matching/mark_success/mark_failed) - the literal Jobs.status string never appears here, db_api owns the action->status mapping and enum enforcement itself (LOCKED_TECH_DECISIONS.md T-02 follow-up).",
  "QueryLanguage": "JSONata",
  "StartAt": "InitializeJob",
  "States": {
    "InitializeJob": {
      "Comment": "First db_api touch point: creates the Jobs row. jobId/eventID/uploaderID are parsed from the upload key (uploads/event/{eventID}/user/{userId}/job/{jobId}/original.zip, T-09) since no Jobs row exists yet to read them from. No Jobs row exists yet if this fails, so its own Catch skips JobFailed and goes straight to IngestionFailed.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${db_api_function_arn}",
        "Payload": {
          "action": "create",
          "jobId": "{% $split($states.input.key, '/')[6] %}",
          "eventID": "{% $split($states.input.key, '/')[2] %}",
          "uploaderID": "{% $split($states.input.key, '/')[4] %}",
          "startedAt": "{% $states.context.Execution.StartTime %}"
        }
      },
      "Output": "{% $merge([$states.input, {'jobId': $split($states.input.key, '/')[6], 'eventID': $split($states.input.key, '/')[2], 'uploaderID': $split($states.input.key, '/')[4]}]) %}",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "IngestionFailed"
        }
      ],
      "Next": "UpdateStatusExtracting"
    },

    "UpdateStatusExtracting": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${db_api_function_arn}",
        "Payload": {
          "action": "mark_extracting",
          "jobId": "{% $states.input.jobId %}"
        }
      },
      "Output": "{% $states.input %}",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Output": "{% $states.input %}",
          "Next": "JobFailed"
        }
      ],
      "Next": "Extract"
    },

    "Extract": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${ingestion_function_arn}",
        "Payload": {
          "step": "extract",
          "bucket": "{% $states.input.bucket %}",
          "key": "{% $states.input.key %}"
        }
      },
      "Output": "{% $states.result.Payload %}",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Output": "{% $states.input %}",
          "Next": "JobFailed"
        }
      ],
      "Next": "UpdateStatusIndexing"
    },

    "UpdateStatusIndexing": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${db_api_function_arn}",
        "Payload": {
          "action": "mark_indexing",
          "jobId": "{% $states.input.jobId %}"
        }
      },
      "Output": "{% $states.input %}",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Output": "{% $states.input %}",
          "Next": "JobFailed"
        }
      ],
      "Next": "IndexPhotos"
    },

    "IndexPhotos": {
      "Type": "Map",
      "Label": "IndexPhotos",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "IndexOnePhoto",
        "States": {
          "IndexOnePhoto": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Arguments": {
              "FunctionName": "${ingestion_function_arn}",
              "Payload": {
                "step": "index_one_photo",
                "eventID": "{% $states.input.eventID %}",
                "photoID": "{% $states.input.photoID %}",
                "s3Key": "{% $states.input.s3Key %}"
              }
            },
            "Output": "{% $states.result.Payload %}",
            "Retry": [
              {
                "ErrorEquals": ["States.ALL"],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "End": true
          }
        }
      },
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "ReaderConfig": {
          "InputType": "JSON"
        },
        "Arguments": {
          "Bucket": "{% $states.input.manifestBucket %}",
          "Key": "{% $states.input.manifestKey %}"
        }
      },
      "MaxConcurrency": ${rekognition_index_max_concurrency},
      "ToleratedFailurePercentage": 100,
      "Output": "{% $merge([$states.input, {'indexResults': $states.result}]) %}",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Output": "{% $states.input %}",
          "Next": "JobFailed"
        }
      ],
      "Next": "Finalize"
    },

    "Finalize": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${ingestion_function_arn}",
        "Payload": {
          "step": "finalize",
          "jobId": "{% $states.input.jobId %}",
          "eventID": "{% $states.input.eventID %}",
          "extractFailedCount": "{% $states.input.extractFailedCount %}",
          "indexResults": "{% $states.input.indexResults %}"
        }
      },
      "Output": "{% $states.result.Payload %}",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Output": "{% $states.input %}",
          "Next": "JobFailed"
        }
      ],
      "Next": "CheckIndexingOutcome"
    },

    "CheckIndexingOutcome": {
      "Comment": "Reads Finalize's own succeededCount - if zero photos succeeded, there is nothing new for ListAttendees/MatchAttendees to match against, so this routes straight to JobFailed and skips them entirely rather than running that work and discarding it.",
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.succeededCount = 0 %}",
          "Next": "JobFailed"
        }
      ],
      "Default": "UpdateStatusMatching"
    },

    "UpdateStatusMatching": {
      "Comment": "An in-progress status, not the terminal outcome - only reached once CheckIndexingOutcome has confirmed at least one photo succeeded. succeededCount/failedCount are carried through unwritten in $states.input for UpdateJobStatus (right before IngestionSucceeded) to write once ListAttendees/MatchAttendees have actually finished.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${db_api_function_arn}",
        "Payload": {
          "action": "mark_matching",
          "jobId": "{% $states.input.jobId %}"
        }
      },
      "Output": "{% $states.input %}",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Output": "{% $states.input %}",
          "Next": "JobFailed"
        }
      ],
      "Next": "ListAttendees"
    },

    "ListAttendees": {
      "Comment": "Runs before Jobs' terminal outcome is written — UpdateStatusTerminal still hasn't run. A failure here or in MatchAttendees now routes through JobFailed (flips Jobs to FAILED) rather than straight to IngestionFailed, since without that the row would otherwise be stuck at MATCHING forever with no terminal status ever written.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${ingestion_function_arn}",
        "Payload": {
          "step": "list_attendees",
          "eventID": "{% $states.input.eventID %}"
        }
      },
      "Output": "{% $merge([$states.input, $states.result.Payload]) %}",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Output": "{% $states.input %}",
          "Next": "JobFailed"
        }
      ],
      "Next": "MatchAttendees"
    },

    "MatchAttendees": {
      "Type": "Map",
      "Label": "MatchAttendees",
      "Items": "{% $states.input.attendeeIDs %}",
      "ItemSelector": {
        "eventID": "{% $states.input.eventID %}",
        "userID": "{% $states.context.Map.Item.Value %}"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "MatchOneAttendeeBatch",
        "States": {
          "MatchOneAttendeeBatch": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Arguments": {
              "FunctionName": "${ingestion_function_arn}",
              "Payload": {
                "step": "match_attendees",
                "eventID": "{% $states.input.eventID %}",
                "userID": "{% $states.input.userID %}"
              }
            },
            "Output": "{% $states.result.Payload %}",
            "Retry": [
              {
                "ErrorEquals": ["States.ALL"],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "End": true
          }
        }
      },
      "MaxConcurrency": ${rekognition_search_max_concurrency},
      "ToleratedFailurePercentage": 100,
      "Output": "{% $states.input %}",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Output": "{% $states.input %}",
          "Next": "JobFailed"
        }
      ],
      "Next": "UpdateJobStatus"
    },

    "UpdateJobStatus": {
      "Comment": "Unconditional - only reached once matching has actually finished, and CheckIndexingOutcome already confirmed at least one photo succeeded earlier, so there is nothing left to branch on here.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${db_api_function_arn}",
        "Payload": {
          "action": "mark_success",
          "jobId": "{% $states.input.jobId %}",
          "succeededCount": "{% $states.input.succeededCount %}",
          "failedCount": "{% $states.input.failedCount %}"
        }
      },
      "Output": "{% $states.input %}",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Output": "{% $states.input %}",
          "Next": "JobFailed"
        }
      ],
      "Next": "IngestionSucceeded"
    },

    "IngestionSucceeded": {
      "Comment": "Explicit success terminal, symmetric with IngestionFailed below — gives the happy path a named, observable end state in execution history rather than just whichever state happens to carry End: true.",
      "Type": "Succeed"
    },

    "JobFailed": {
      "Comment": "Reached either by an execution-level failure (Extract crashing, IndexPhotos' Map itself erroring, ListAttendees/MatchAttendees failing, etc.) or by CheckIndexingOutcome finding zero photos succeeded. Every prior state's Catch preserves jobId in $states.input for this to read.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${db_api_function_arn}",
        "Payload": {
          "action": "mark_failed",
          "jobId": "{% $states.input.jobId %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "IngestionFailed"
    },

    "IngestionFailed": {
      "Type": "Fail",
      "Error": "IngestionPipelineFailed",
      "Cause": "The ingestion pipeline execution failed before reaching a normal terminal state; see this execution's history for the failing state and error detail."
    }
  }
}
