pipeline {
    agent any

    environment {
        AWS_PROFILE = 'glimpses'
    }

    stages {
        stage('Build') {
            steps {
                dir('Backend/notifications') {
                    sh '''
                        set -e
                        rm -rf build build.zip
                        mkdir -p build
                        python3 -m pip install -r requirements.txt \
                          --target build \
                          --platform manylinux2014_x86_64 \
                          --implementation cp \
                          --python-version 3.13 \
                          --only-binary=:all: \
                          --upgrade
                        cp -r src/. build/
                        cd build && zip -r ../build.zip . && cd ..
                    '''
                }
            }
        }
        stage('Push to deployment-artifacts') {
            steps {
                dir('Backend/notifications') {
                    sh 'aws s3 cp build.zip s3://glimpses-deploy-artifacts/notifications/build.zip'
                }
            }
        }
        stage('Fetch frontend domain') {
            steps {
                dir('Frontend/frontend') {
                    sh 'terraform init'
                    script {
                        env.FRONTEND_DOMAIN = sh(script: 'terraform output -raw distribution_domain_name', returnStdout: true).trim()
                    }
                }
            }
        }
        stage('Terraform Init') {
            steps {
                dir('Infrastructure') {
                    sh 'terraform init'
                }
            }
        }
        stage('Verify SES readiness') {
            steps {
                dir('Infrastructure') {
                    sh '''
                        set -e
                        SENDER_EMAIL=$(terraform output -raw ses_sender_email)
                        VERIFIED=$(aws sesv2 get-email-identity --region ap-south-1 --email-identity "$SENDER_EMAIL" --query VerifiedForSendingStatus --output text)
                        PRODUCTION=$(aws sesv2 get-account --region ap-south-1 --query ProductionAccessEnabled --output text)
                        if [ "$VERIFIED" != "True" ] || [ "$PRODUCTION" != "True" ]; then
                            echo 'SES sender verification and production access are required before notifications can run.'
                            exit 1
                        fi
                    '''
                }
            }
        }
        stage('Terraform Validate') {
            steps {
                dir('Infrastructure') {
                    sh 'terraform validate'
                }
            }
        }
        stage('Terraform Apply - notifications') {
            steps {
                dir('Infrastructure') {
                    sh 'terraform apply -target=module.notifications -var frontend_domain_name=${FRONTEND_DOMAIN} -auto-approve'
                }
            }
        }
        stage('Update Lambda code') {
            steps {
                sh 'aws lambda update-function-code --function-name glimpses-notifications --s3-bucket glimpses-deploy-artifacts --s3-key notifications/build.zip'
            }
        }
    }
}
