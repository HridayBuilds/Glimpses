pipeline {
    agent any

    environment {
        AWS_PROFILE = 'glimpses'
    }

    stages {
        stage('Build') {
            steps {
                dir('Backend/profile') {
                    sh '''
                        set -e
                        rm -rf build build.zip
                        mkdir -p build
                        python3 -m pip install -r requirements.txt \
                          --target build \
                          --platform manylinux2014_x86_64 \
                          --implementation cp \
                          --python-version 3.13 \
                          --only-binary=:all: \
                          --upgrade
                        cp -r src/. build/
                        cd build && zip -r ../build.zip . && cd ..
                    '''
                }
            }
        }
        stage('Push to deployment-artifacts') {
            steps {
                dir('Backend/profile') {
                    sh 'aws s3 cp build.zip s3://glimpses-deploy-artifacts/profile/build.zip'
                }
            }
        }
        stage('Terraform Init') {
            steps {
                dir('Infrastructure') {
                    sh 'terraform init'
                }
            }
        }
        stage('Terraform Validate') {
            steps {
                dir('Infrastructure') {
                    sh 'terraform validate'
                }
            }
        }
        stage('Terraform Apply - profile') {
            steps {
                dir('Infrastructure') {
                    sh 'terraform apply -target=module.profile -auto-approve'
                }
            }
        }
        stage('Update Lambda code') {
            steps {
                sh 'aws lambda update-function-code --function-name glimpses-profile --s3-bucket glimpses-deploy-artifacts --s3-key profile/build.zip'
            }
        }
    }
}
